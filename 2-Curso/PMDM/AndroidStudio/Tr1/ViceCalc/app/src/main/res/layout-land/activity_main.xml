<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fitsSystemWindows="true"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    tools:context=".MainActivity">

    <!-- Título y subtítulo -->

    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="@string/titulo"
        android:textColor="@color/rosa_neon"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textModo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="@string/modo_cientifico"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:letterSpacing="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textTitulo"
        app:layout_constraintBottom_toBottomOf="@id/textTitulo" />

    <!-- Pantalla de resultados -->

    <LinearLayout
        android:id="@+id/layoutResultado"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:orientation="vertical"
        android:background="@drawable/fondo_resultado"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/textTitulo"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textOperacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:maxLines="1"
            tools:text="125 × 8" />

        <TextView
            android:id="@+id/textResultado"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|end"
            android:text="@string/resultado_inicial"
            android:textColor="@color/texto_principal"
            android:textSize="32sp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeStepGranularity="1sp" />

    </LinearLayout>

    <!-- Primera fila: DEG, sin, cos, tan, AC, signo, porcentaje y división -->

    <Button
        android:id="@+id/btnGrados"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_grados"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btnSin"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_sin"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btnCos"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_cos"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnTan"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_tan"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical4" />

    <Button
        android:id="@+id/btnAC"
        style="@style/BotonFuncionHorizontal"
        android:text="@string/btn_ac"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical4"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical5" />

    <Button
        android:id="@+id/btnSigno"
        style="@style/BotonFuncionHorizontal"
        android:text="@string/btn_signo"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical5"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical6" />

    <Button
        android:id="@+id/btnPorcentaje"
        style="@style/BotonFuncionHorizontal"
        android:text="@string/btn_porcentaje"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical6"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical7" />

    <Button
        android:id="@+id/btnDividir"
        style="@style/BotonOperacionHorizontal"
        android:text="@string/btn_dividir"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical7"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Segunda fila: pi, asin, acos, atan, 7, 8, 9 y multiplicación -->

    <Button
        android:id="@+id/btnPi"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_pi"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btnAsin"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_asin"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btnAcos"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_acos"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnAtan"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_atan"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical4" />

    <Button
        android:id="@+id/btn7"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_7"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical4"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical5" />

    <Button
        android:id="@+id/btn8"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_8"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical5"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical6" />

    <Button
        android:id="@+id/btn9"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_9"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical6"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical7" />

    <Button
        android:id="@+id/btnMultiplicar"
        style="@style/BotonOperacionHorizontal"
        android:text="@string/btn_multiplicar"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical7"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tercera fila: e, cuadrado, cubo, potencia, 4, 5, 6 y resta -->

    <Button
        android:id="@+id/btnE"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_e"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btnCuadrado"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_cuadrado"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btnCubo"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_cubo"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnPotencia"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_potencia"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical4" />

    <Button
        android:id="@+id/btn4"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_4"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical4"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical5" />

    <Button
        android:id="@+id/btn5"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_5"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical5"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical6" />

    <Button
        android:id="@+id/btn6"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_6"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical6"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical7" />

    <Button
        android:id="@+id/btnRestar"
        style="@style/BotonOperacionHorizontal"
        android:text="@string/btn_restar"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical7"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cuarta fila: inverso, raíces, log, 1, 2, 3 y suma -->

    <Button
        android:id="@+id/btnInverso"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_inverso"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btnRaiz"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_raiz"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btnRaizCubica"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_raiz_cubica"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnLog"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_log"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical4" />

    <Button
        android:id="@+id/btn1"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_1"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical4"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical5" />

    <Button
        android:id="@+id/btn2"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_2"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical5"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical6" />

    <Button
        android:id="@+id/btn3"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_3"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical6"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical7" />

    <Button
        android:id="@+id/btnSumar"
        style="@style/BotonOperacionHorizontal"
        android:text="@string/btn_sumar"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical7"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quinta fila: factorial, absoluto, exponencial, ln, borrar, 0, decimal e igual -->

    <Button
        android:id="@+id/btnFactorial"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_factorial"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btnAbsoluto"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_absoluto"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btnExponencial"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_exponencial"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnLn"
        style="@style/BotonCientificoHorizontal"
        android:text="@string/btn_ln"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical4" />

    <Button
        android:id="@+id/btnBorrar"
        style="@style/BotonFuncionHorizontal"
        android:text="@string/btn_borrar"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical4"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical5" />

    <Button
        android:id="@+id/btn0"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_0"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical5"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical6" />

    <Button
        android:id="@+id/btnDecimal"
        style="@style/BotonNumeroHorizontal"
        android:text="@string/btn_decimal"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical6"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical7" />

    <Button
        android:id="@+id/btnIgual"
        style="@style/BotonHorizontal"
        android:text="@string/btn_igual"
        android:background="@drawable/fondo_igual"
        android:textColor="@color/fondo_principal"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical7"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guidelines verticales -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical1"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.125" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical2"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical3"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.375" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical4"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical5"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.625" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical6"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.75" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical7"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.875" />

    <!-- Guidelines horizontales -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal1"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.35" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal2"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.48" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal3"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.61" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal4"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.74" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal5"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.87" />

</androidx.constraintlayout.widget.ConstraintLayout>