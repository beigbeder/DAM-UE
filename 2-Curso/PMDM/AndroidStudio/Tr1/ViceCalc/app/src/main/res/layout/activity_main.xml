<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Título y subtítulo -->

    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="@string/titulo"
        android:textColor="@color/rosa_neon"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textModo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modo_basico"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:letterSpacing="0.2"
        app:layout_constraintStart_toStartOf="@id/textTitulo"
        app:layout_constraintTop_toBottomOf="@id/textTitulo" />

    <!-- Pantalla de resultados -->

    <LinearLayout
        android:id="@+id/layoutResultado"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/fondo_resultado"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/textModo"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textOperacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            tools:text="125 × 8" />

        <TextView
            android:id="@+id/textResultado"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|end"
            android:text="@string/resultado_inicial"
            android:textColor="@color/texto_principal"
            android:textSize="48sp" />

    </LinearLayout>

    <!-- Primera fila: AC, signo, porcentaje y división -->

    <Button
        android:id="@+id/btnAC"
        style="@style/BotonFuncion"
        android:text="@string/btn_ac"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btnSigno"
        style="@style/BotonFuncion"
        android:text="@string/btn_signo"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btnPorcentaje"
        style="@style/BotonFuncion"
        android:text="@string/btn_porcentaje"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnDividir"
        style="@style/BotonOperacion"
        android:text="@string/btn_dividir"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal1"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Segunda fila: 7, 8, 9 y multiplicación -->

    <Button
        android:id="@+id/btn7"
        style="@style/BotonNumero"
        android:text="@string/btn_7"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btn8"
        style="@style/BotonNumero"
        android:text="@string/btn_8"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btn9"
        style="@style/BotonNumero"
        android:text="@string/btn_9"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnMultiplicar"
        style="@style/BotonOperacion"
        android:text="@string/btn_multiplicar"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal2"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tercera fila: 4, 5, 6 y resta -->

    <Button
        android:id="@+id/btn4"
        style="@style/BotonNumero"
        android:text="@string/btn_4"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btn5"
        style="@style/BotonNumero"
        android:text="@string/btn_5"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btn6"
        style="@style/BotonNumero"
        android:text="@string/btn_6"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnRestar"
        style="@style/BotonOperacion"
        android:text="@string/btn_restar"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal3"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cuarta fila: 1, 2, 3 y suma -->

    <Button
        android:id="@+id/btn1"
        style="@style/BotonNumero"
        android:text="@string/btn_1"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btn2"
        style="@style/BotonNumero"
        android:text="@string/btn_2"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btn3"
        style="@style/BotonNumero"
        android:text="@string/btn_3"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnSumar"
        style="@style/BotonOperacion"
        android:text="@string/btn_sumar"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal4"
        app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quinta fila: borrar, 0, decimal e igual -->

    <Button
        android:id="@+id/btnBorrar"
        style="@style/BotonFuncion"
        android:text="@string/btn_borrar"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical1" />

    <Button
        android:id="@+id/btn0"
        style="@style/BotonNumero"
        android:text="@string/btn_0"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical1"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical2" />

    <Button
        android:id="@+id/btnDecimal"
        style="@style/BotonNumero"
        android:text="@string/btn_decimal"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical2"
        app:layout_constraintEnd_toStartOf="@id/guidelineVertical3" />

    <Button
        android:id="@+id/btnIgual"
        style="@style/BotonCalculadora"
        android:text="@string/btn_igual"
        android:background="@drawable/fondo_igual"
        android:textColor="@color/fondo_principal"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="@id/guidelineHorizontal5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineVertical3"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guidelines verticales -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical1"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical2"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical3"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.75" />

    <!-- Guidelines horizontales -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal1"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.40" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal2"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.52" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal3"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.64" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal4"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.76" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal5"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.88" />

</androidx.constraintlayout.widget.ConstraintLayout>