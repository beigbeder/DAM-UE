<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- CALCULADORA VERTICAL -->

    <!-- Estilo base -->
    <style name="BotonCalculadora">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Botones numéricos -->
    <style name="BotonNumero" parent="BotonCalculadora">
        <item name="backgroundTint">@color/boton_numero</item>
    </style>

    <!-- Botones de funciones -->
    <style name="BotonFuncion" parent="BotonCalculadora">
        <item name="backgroundTint">@color/boton_funcion</item>
    </style>

    <!-- Botones de operaciones -->
    <style name="BotonOperacion" parent="BotonCalculadora">
        <item name="backgroundTint">@color/boton_operacion</item>
    </style>

    <!-- Botones científicos -->
    <style name="BotonCientifico" parent="BotonCalculadora">
        <item name="backgroundTint">@color/boton_cientifico</item>
    </style>


    <!-- CALCULADORA HORIZONTAL -->

    <!-- Estilo base -->
    <style name="BotonHorizontal" parent="BotonCalculadora">
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Botones numéricos -->
    <style name="BotonNumeroHorizontal" parent="BotonHorizontal">
        <item name="backgroundTint">@color/boton_numero</item>
    </style>

    <!-- Botones de funciones -->
    <style name="BotonFuncionHorizontal" parent="BotonHorizontal">
        <item name="backgroundTint">@color/boton_funcion</item>
    </style>

    <!-- Botones de operaciones -->
    <style name="BotonOperacionHorizontal" parent="BotonHorizontal">
        <item name="backgroundTint">@color/boton_operacion</item>
    </style>

    <!-- Botones científicos -->
    <style name="BotonCientificoHorizontal" parent="BotonHorizontal">
        <item name="backgroundTint">@color/boton_cientifico</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>